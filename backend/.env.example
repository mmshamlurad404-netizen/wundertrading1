# NebulaTrade optional integrations
# Copy to .env and fill in your own credentials. All features stay disabled
# until the corresponding variables are provided.

# ---- Live market data ----
# Set to 0 to run fully offline on the deterministic simulator.
NT_LIVE_MARKET=1
# Comma-separated feed priority, e.g. binance,wallex,nobitex,ompfinex
NT_FEED_PRIORITY=binance,wallex,nobitex,ompfinex
# How often to preload real candles for bots/screener (ms).
NT_WARM_INTERVAL_MS=30000

# ---- Auth ----
# Change this in production.
JWT_SECRET=change-me

# ---- Encrypting exchange API keys at rest ----
# Optional 32-byte passphrase. If unset a random key file is generated.
NT_SECRET=

# ---- Realistic paper execution ----
# Taker fee (0.0005 = 5 bps) and fallback slippage when no book is available.
NT_PAPER_FEE=0.0005
NT_PAPER_SLIPPAGE_BPS=2

# ---- Optional LLM-backed AI strategy (OpenAI-compatible) ----
# Leave NT_LLM_API_KEY empty to keep the built-in rule-based model.
NT_LLM_API_KEY=
NT_LLM_BASE_URL=https://api.openai.com/v1
NT_LLM_MODEL=gpt-4o-mini
NT_LLM_TIMEOUT_MS=15000

# ---- Optional email alerts (SMTP) ----
NT_SMTP_HOST=
NT_SMTP_PORT=587
NT_SMTP_SECURE=false
NT_SMTP_USER=
NT_SMTP_PASS=
NT_SMTP_FROM=

# ---- Live account reconciliation ----
NT_SYNC_INTERVAL_MS=15000
